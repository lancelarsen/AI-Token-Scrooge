{
  "content_scripts": [
    {
      "world": "MAIN",
      "run_at": "document_start",
      "js": [
        "capture.js"
      ],
      "matches": [
        "https://platform.openai.com/*"
      ]
    },
    {
      "world": "ISOLATED",
      "run_at": "document_start",
      "js": [
        "relay.js"
      ],
      "matches": [
        "https://platform.openai.com/*"
      ]
    }
  ],
  "key": "",
  "description": "Read OpenAI API credit balances for AI Token Scrooge using your existing Chrome sign-in.",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "version": "0.1.1",
  "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://platform.openai.com/*"
  ],
  "action": {
    "default_icon": { "16": "icon.png", "32": "icon.png" },
    "default_popup": "popup.html",
    "default_title": "Scrooge API Credits"
  },
  "name": "Scrooge API Credits",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "manifest_version": 3
}
