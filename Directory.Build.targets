<Project>
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0'))">
    <!-- Pin the supported .NET runtime patch without changing the Windows SDK reference version. -->
    <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.AspNetCore.App"
                             LatestRuntimeFrameworkVersion="10.0.13" DefaultRuntimeFrameworkVersion="10.0.13" />
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.AspNetCore.App" RuntimeFrameworkVersion="10.0.13" />
  </ItemGroup>
</Project>
